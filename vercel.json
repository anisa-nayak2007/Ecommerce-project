{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/product",
      "destination": "/client/product.html"
    },
    {
      "source": "/checkout",
      "destination": "/client/checkout.html"
    },
    {
      "source": "/order-confirmation",
      "destination": "/client/order-confirmation.html"
    },
    {
      "source": "/profile",
      "destination": "/client/profile.html"
    },
    {
      "source": "/admin",
      "destination": "/client/admin.html"
    },
    {
      "source": "/",
      "destination": "/client/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/client/$1"
    }
  ]
}
